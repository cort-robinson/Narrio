{
  "name": "narrio-release-tooling",
  "private": true,
  "type": "module",
  "engines": { "node": "^22.14.0 || >=24.10.0" },
  "scripts": {
    "test": "node --test scripts/release/*.test.mjs",
    "release:preview": "node scripts/release/preview.mjs",
    "release:dev": "node scripts/release/preview.mjs --build",
    "release": "node scripts/release/publish.mjs"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "conventional-changelog-conventionalcommits": "8.0.0",
    "semantic-release": "25.0.9"
  }
}
